<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <turboFilter class="pl.aiwcorpo.mcp.broker.config.HttpLayerDebugGuard"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- C8: one JSON object per line, nothing else on the line, so the SIEM shipper and `make audit` can parse it. -->
    <appender name="AUDIT_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_STDOUT"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
