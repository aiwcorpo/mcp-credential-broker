# Environment of the broker: copy to /etc/mcp-credential-broker/mcp-credential-broker.env (root:broker, mode 0640) and fill in the
# empty values. With your own PostgreSQL and Redis nothing is generated, so every password is set here.

SPRING_CONFIG_IMPORT=optional:configtree:/var/lib/mcp-credential-broker/secrets/broker/env/

# Listening port (TLS, client certificate required).
MCP_BROKER_PORT=8443

MCP_PORTAL_URL=https://mcp.corp.test

MCP_OIDC_ISSUER=https://idp.corp.test/realms/corp
MCP_OIDC_JWKS_URI=https://idp.corp.test/realms/corp/protocol/openid-connect/certs
MCP_OIDC_AUDIENCE=mcp-credential-broker
# The azp of the portal's token (comma separated).
MCP_BFF_ALLOWED_AZP=mcp-portal-bff

MCP_BAO_ADDR=https://openbao.corp.internal:8200
MCP_BAO_ROLE_ID=
MCP_BAO_SECRET_ID=

# The host of the URL must be the name in the gateway certificate.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json
MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# The certificate of the broker (CN mcp-credential-broker, SAN mcp-credential-broker.internal, server use) and the internal CA, both
# PKCS12 with one password. The broker trusts only this truststore: put the CA of the identity provider and of OpenBao in it too.
MCP_TLS_KEYSTORE=/etc/mcp-credential-broker/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-credential-broker/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

MCP_DB_URL=jdbc:postgresql://postgres.corp.internal:5432/broker
MCP_DB_USER=broker
MCP_DB_PASSWORD=

# Redis with an account for the broker (README.md, "Virtual machine without Docker").
MCP_REDIS_HOST=redis.corp.internal
MCP_REDIS_PORT=6379
MCP_REDIS_USER=broker
MCP_REDIS_PASSWORD=

# Only for systems of the credential type token-exchange:
# BROKER_BFFTOKEN_TOKENURL=https://idp.corp.test/realms/corp/protocol/openid-connect/token
# BROKER_TOKENEXCHANGE_ALLOWEDAUDIENCES=opensearch
# Only when the identity provider reports MFA in acr instead of amr:
# BROKER_BFFTOKEN_MFAACRVALUES=mfa
