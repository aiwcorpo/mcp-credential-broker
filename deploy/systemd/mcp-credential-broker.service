# systemd unit: /etc/systemd/system/mcp-credential-broker.service
#   systemctl daemon-reload && systemctl enable --now mcp-credential-broker
[Unit]
Description=MCP platform: mcp-credential-broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=broker
Group=broker
# Addresses and secrets (deploy/systemd/mcp-credential-broker.env); logs go to journald.
EnvironmentFile=/etc/mcp-credential-broker/mcp-credential-broker.env
# Checks the configuration and the connections (certificates, identity provider, OpenBao login, gateway keys); the broker does not
# start when it fails (journalctl -u mcp-credential-broker shows why). PostgreSQL and Redis are your own, so nothing is generated.
ExecStartPre=/usr/bin/java -jar /opt/mcp-credential-broker/broker.jar init /var/lib/mcp-credential-broker/secrets
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/mcp-credential-broker/broker.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The JIT needs writable and executable memory.
MemoryDenyWriteExecute=false
ReadOnlyPaths=/etc/mcp-credential-broker /opt/mcp-credential-broker
StateDirectory=mcp-credential-broker
StateDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Heap is 75 percent of what the unit may use; set the limit to the host's budget.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
