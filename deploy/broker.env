# Configuration of the credential broker. Fill in the empty values; "docker compose up -d" tells you what is still missing.
# Passwords of the broker's PostgreSQL and Redis and the Redis ACL are generated on the first start.

# The https origin of the portal: where the broker sends a user back after connecting an account with OAuth.
MCP_PORTAL_URL=

# Identity provider (a Keycloak realm): issuer and the URL of its signing keys. The broker checks the token of the portal with them.
# For Keycloak: https://<host>/realms/<realm> and https://<host>/realms/<realm>/protocol/openid-connect/certs
MCP_OIDC_ISSUER=
MCP_OIDC_JWKS_URI=

# The azp of the portal's token: the client id of the portal at the identity provider. Comma separated.
MCP_BFF_ALLOWED_AZP=mcp-portal-bff

# OpenBao (README.md, "OpenBao"): its address and the AppRole of the broker.
MCP_BAO_ADDR=
MCP_BAO_ROLE_ID=
MCP_BAO_SECRET_ID=

# The gateway: where the broker fetches the keys of the internal JWT. The host of the URL must be the name in the gateway certificate.
# For the default certificate: https://mcp-gateway.internal:8443/.well-known/jwks.json
MCP_GATEWAY_JWKS_URI=
MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# Only for systems of the credential type token-exchange (the portal's token is exchanged at the identity provider):
# BROKER_BFFTOKEN_TOKENURL=https://<host>/realms/<realm>/protocol/openid-connect/token
# BROKER_TOKENEXCHANGE_ALLOWEDAUDIENCES=opensearch

# Only when the identity provider reports MFA in acr instead of amr (needed to change systems in the portal):
# BROKER_BFFTOKEN_MFAACRVALUES=mfa
